{
  "name": "turzx-render",
  "version": "1.0.2",
  "description": "Node.js and TypeScript library and CLI for TURZX / Turing Smart Screen 3.5-inch USB displays. Render images, SVG dashboards and RGB565 partial updates on macOS.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "example:dashboard": "node examples/dashboard.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "usb": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "turzx": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "assets",
    "README.md",
    "LICENSE",
    "PUBLISHING.md",
    "tsconfig.json"
  ],
  "author": "Pamsho09",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pamsho09/turzx-render.git"
  },
  "homepage": "https://github.com/Pamsho09/turzx-render#readme",
  "bugs": {
    "url": "https://github.com/Pamsho09/turzx-render/issues"
  },
  "keywords": [
    "turzx",
    "turing-smart-screen",
    "turing",
    "usbmonitor",
    "usb-display",
    "lcd",
    "display",
    "dashboard",
    "rgb565",
    "libusb",
    "nodejs",
    "typescript",
    "macos"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
